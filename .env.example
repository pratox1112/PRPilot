# Copy to .env and fill in. .env is gitignored; never commit real values.

# GitHub fine-grained token, read-only access to public repositories (feasibility + data scripts)
GITHUB_TOKEN=

# GitHub App (sandbox repos only). The private key file stays OUTSIDE the repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Hugging Face token with access to meta-llama/Llama-Prompt-Guard-2-86M
HF_TOKEN=

# Langfuse Cloud project keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Google Cloud project for BigQuery (GH Archive) and later deployment
GCP_PROJECT=

# Local services (services/local.py). docker compose up -d db for Postgres.
DATABASE_URL=postgresql+asyncpg://prpilot:prpilot@localhost:5433/prpilot
# Long random string; the approval API refuses every request without it.
ADMIN_TOKEN=
# Comma-separated repos the bot may triage and write to (everything else is refused).
SANDBOX_REPOS=
# true (default): the executor records approved actions but writes nothing to GitHub.
EXECUTOR_DRY_RUN=true
# llama.cpp server with the student GGUF
MODEL_BASE_URL=http://127.0.0.1:8080/v1
MODEL_NAME=prpilot-model
# true: send Pydantic AI traces (screened prompts, replies, usage) to Langfuse (keys above).
TRACING=false
