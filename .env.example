# Copy to .env and fill in. .env is gitignored; never commit real values.

# GitHub fine-grained token, read-only access to public repositories (feasibility + data scripts)
GITHUB_TOKEN=

# GitHub App (sandbox repos only). The private key file stays OUTSIDE the repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Hugging Face token with access to meta-llama/Llama-Prompt-Guard-2-86M
HF_TOKEN=

# Langfuse Cloud project keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Google Cloud project for BigQuery (GH Archive) and later deployment
GCP_PROJECT=
